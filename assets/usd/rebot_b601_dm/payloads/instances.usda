        over "base_link_silver_trim" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_link_silver_trim/VisualMaterials/silver_trim>
            custom string urdf:name = "base_link_silver_trim"
        }

        def Scope "VisualMaterials"
        {
            def Material "silver_trim" (
