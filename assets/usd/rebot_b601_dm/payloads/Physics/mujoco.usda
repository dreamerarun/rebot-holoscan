        )
        {
        }

        def MjcActuator "joint1_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -10.471975326538086, -0.6981316804885864, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 27
            uniform double mjc:forceRange:min = -27
            uniform double[] mjc:gainPrm = [10.471975326538086, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </ReBot_Arm_DM/Physics/joint1>
        }

