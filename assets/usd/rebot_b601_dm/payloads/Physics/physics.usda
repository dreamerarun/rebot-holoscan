    over "Physics"
    {
        def PhysicsPrismaticJoint "finger_right" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 100
            float drive:linear:physics:maxForce = 8
            float drive:linear:physics:stiffness = 3000
            uniform token drive:linear:physics:type = "force"
            float newton:mimicCoef1 = -1
            rel newton:mimicJoint = </ReBot_Arm_DM/Physics/finger_left>
            float newton:velocityLimit = 0.08
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </ReBot_Arm_DM/Geometry/base_link/link1/link2/link3/link4/link5/link6/end_link>
            custom rel physics:body1
            append rel physics:body1 = </ReBot_Arm_DM/Geometry/base_link/link1/link2/link3/link4/link5/link6/end_link/finger_right_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, -3.413417e-22, -1.1520114e-22, 2.4535396e-27)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.05
            float physics:upperLimit = 0
            custom float urdf:limit:effort = 8
        }

